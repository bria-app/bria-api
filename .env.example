APP_NAME="bria API"
# development | test | production. Railway MUST use production: disables /docs and
# /openapi.json, removes the simulated billing webhook, enforces a strong JWT secret and
# refuses the mock FTGM engine (unless ALLOW_FTGM_MOCK=true).
APP_ENV=development
# true echoes every SQL statement (very noisy) — keep false unless debugging queries.
APP_DEBUG=false
API_V1_PREFIX=/api/v1

# Load the PetHouse demo company once on an empty database (scripts/bootstrap_demo.py).
SEED_DEMO=false
# Demo user passwords (required when SEED_DEMO=true outside APP_ENV=development; in
# development they fall back to local defaults). Never commit real values.
DEMO_OWNER_PASSWORD=
DEMO_SELLER_PASSWORD=

# bria-local publica PostgreSQL en el puerto 5433 de esta máquina, con base y usuario bria.
DATABASE_URL=postgresql+psycopg://bria:<POSTGRES_PASSWORD>@localhost:5433/bria

# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000
# Optional regex for dynamic origins (Railway: https://.*\.up\.railway\.app)
CORS_ORIGIN_REGEX=

# Outside development/test the API refuses to start if this is a placeholder or < 32 bytes.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-this-in-production-use-a-strong-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# real = engine desplegado | mock = demo sin engine (ver perfiles-demo/INSTRUCCIONES.txt)
FTGM_ENGINE_MODE=real
FTGM_ENGINE_BASE_URL=http://localhost:8010/api/v1
# Respected as configured (no hidden minimum).
FTGM_ENGINE_TIMEOUT_SECONDS=180
# Shared secret with the engine (its ENGINE_API_KEY). When set, sent as X-Engine-Key.
FTGM_ENGINE_API_KEY=
# Only to run the mock engine with APP_ENV=production on purpose (public demo). Never in
# validation sessions with real users.
ALLOW_FTGM_MOCK=false

# Storage backend for uploaded files:
#   db    -> stored in Postgres (survives restarts; required on ephemeral hosts)
#   local -> written to STORAGE_ROOT on disk (local dev only)
STORAGE_BACKEND=db
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_MB=10
# Comma-separated list of allowed MIME types
ALLOWED_UPLOAD_MIME_TYPES=text/csv,application/vnd.ms-excel,application/json

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
EMAILS_FROM_NAME="bria"
